# =================================================================================
# 📊 SERVICE DE MÉTRIQUES SUPERVIA - CONFIGURATION D'EXEMPLE
# =================================================================================
# Ce fichier sert de modèle pour votre propre fichier .env.
# Copiez ce fichier en .env et remplacez les valeurs ci-dessous.
# NE JAMAIS COMMITER VOTRE FICHIER .env DANS LE DÉPÔT GIT.

# ==============================================
# 📡 CONFIGURATION SERVEUR
# ==============================================
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# ==============================================
# 🔑 SÉCURITÉ & AUTHENTIFICATION
# ==============================================
# Secret pour vérifier les JWT des autres services et pour sécuriser l'API interne.
# DOIT être identique dans tous les microservices qui communiquent entre eux.
# Vous pouvez en générer un nouveau avec : npm run generate-jwt
JWT_SECRET=a_very_long_and_secure_jwt_secret_key_that_is_at_least_32_characters_long

# ==============================================
# 🔗 COMMUNICATION INTER-SERVICES
# ==============================================
# URLs des autres services SupervIA. Utilisées par le collecteur pour récupérer les métriques.
# En environnement Docker, utilisez les noms de service.
AUTH_SERVICE_URL=http://auth-service:3001
DB_SERVICE_URL=http://db-service:3002
AI_SERVICE_URL=http://ai-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3005
FRONTEND_URL=http://frontend-gateway:3000

# ==============================================
# 🗄️ INFRASTRUCTURE DE SUPERVISION
# ==============================================
# URL de l'instance Prometheus pour les requêtes PromQL.
PROMETHEUS_URL=http://prometheus:9090

# Configuration Redis (pour le cache des métriques et alertes).
# Le DB index (ex: /2) permet de séparer les données de ce service des autres.
REDIS_URL=redis://supervia-redis:6379/2
REDIS_PASSWORD= # Laissez vide s'il n'y a pas de mot de passe

# ==============================================
# ⚙️ CONFIGURATION DE LA COLLECTE & ALERTING
# ==============================================
# Intervalle de collecte des métriques sur les autres services (en millisecondes).
METRICS_COLLECTION_INTERVAL=60000

# Intervalle de vérification des règles d'alerte (en millisecondes).
ALERTS_CHECK_INTERVAL=300000

# Durée de rétention des données d'alerte et de métriques dans le cache/stockage local.
ALERT_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=30

# ==============================================
# 🔔 NOTIFICATIONS D'ALERTE
# ==============================================
# Email destinataire par défaut pour les alertes.
ALERT_RECIPIENT_EMAIL=admin@supervia.com

# Activez ou désactivez les notifications par canal.
ENABLE_EMAIL_ALERTS=true
ENABLE_SLACK_ALERTS=false

# URL du webhook Slack (si activé).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================
# 🌐 CORS
# ==============================================
# Origines autorisées pour les requêtes cross-domain (séparées par des virgules).
# Doit inclure l'URL de votre frontend et de Grafana si nécessaire.
CORS_ORIGINS=http://localhost:3000,http://localhost:3030

# ==============================================
# 📊 CONFIGURATION SERVICE DE MÉTRIQUES SUPERVIA
# ==============================================
# Variables d'environnement pour le service de métriques
# L'infrastructure (Redis, Prometheus, Grafana) est gérée dans /infra/

# Configuration de base
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Redis partagé (utilise l'infrastructure centralisée)
REDIS_URL=redis://supervia-redis:6379/2
REDIS_PASSWORD=
REDIS_DB=2

# Authentification JWT
JWT_SECRET=metrics_jwt_secret_change_this_in_production

# ==============================================
# 🐳 URLS DES SERVICES DOCKER
# ==============================================
# Utilisé pour la communication inter-services au sein du réseau Docker
AUTH_SERVICE_URL=http://auth-service:3001
DB_SERVICE_URL=http://db-service:3002
NOTIFICATION_SERVICE_URL=http://notification-service:3005
AI_SERVICE_URL=http://ai-service:3004

# ==============================================
# 📡 CONFIGURATION PROMETHEUS
# ==============================================
# URL de l'instance Prometheus pour les requêtes PromQL
PROMETHEUS_URL=http://prometheus:9090

# ==============================================
# 🔑 SÉCURITÉ
# ==============================================
# Services à monitorer (URLs de l'infrastructure partagée)
PAYMENT_SERVICE_URL=http://supervia-payment-service:3006
FRONTEND_URL=http://supervia-frontend-gateway:3000
ALERT_RECIPIENT_EMAIL=admin@supervia.com

# Prometheus (utilise l'infrastructure centralisée)
# Configuration de collecte
COLLECTION_INTERVAL=30
DATA_RETENTION_DAYS=30
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85
ALERT_THRESHOLD_RESPONSE_TIME=2000

# Notifications d'alertes
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Configuration avancée
MAX_CONCURRENT_COLLECTIONS=5
METRICS_HISTORY_CLEANUP_INTERVAL=86400

# NOTE: Grafana est configuré dans /infra/ et accessible sur http://localhost:3030